	measure '_1 Text Trips Num' =
			
			
			VAR _Current = [Trips Num]
			VAR _PrMonth = [_1 Previous Month Trips Num]
			VAR _Growth = DIVIDE(_Current-_PrMonth, _PrMonth)
			
			RETURN
			IF(_Growth <> 0,
			    FORMAT(_Current-_PrMonth, "#,##0")
			    & FORMAT(_Growth, " | 0.0% ▲; | 0.0% ▼;")
			    & " MoM",
