	measure 'Color for Week Day' = ```
			
			
			VAR CurrentNum = [Trips Num]
			
			VAR MaxNumber = 
			CALCULATE(
			    MAXX(VALUES('Dim Date'[Week Day]), [Trips Num]),
			    ALLSELECTED('Dim Date')
			)
			
			VAR MinNum = 
			CALCULATE(
			    MINX(VALUES('Dim Date'[Week Day]), [Trips Num]),
			    ALLSELECTED('Dim Date')
			)
			
			RETURN
			
			SWITCH(
			    TRUE(),
			    CurrentNum = MaxNumber, "#2E8B57",
			    CurrentNum = MinNum, "#de283b",
			    "#647CA1"
			)
			
			```
		displayFolder: Colors
		lineageTag: 2dc2ea08-6404-4978-814e-b6132c12ff5c

	measure 'Color for Time' = ```
			
			
			VAR CurrentNum = [Trips Num]
			
			VAR MaxNumber = 
			CALCULATE(
			    MAXX(VALUES('HourTable'[HourFormatted]), [Trips Num]),
			    ALLSELECTED('HourTable')
			)
			
			VAR MinNum = 
			CALCULATE(
			    MINX(VALUES('HourTable'[HourFormatted]), [Trips Num]),
			    ALLSELECTED('HourTable')
			)
			
			RETURN
			
			SWITCH(
			    TRUE(),
			    CurrentNum = MaxNumber, "#2E8B57",
			    CurrentNum = MinNum, "#de283b",
			    "#647CA1"
			)
			```
		displayFolder: Colors
		lineageTag: 4ed17c34-e9a2-4a08-bb08-df754c5ac636

	measure 'Trips Number Summary HTML' = ```
			
			
			VAR BestWeekDay =
			MAXX(
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            VALUES('Dim Date'[FullDayName]),
			            "TripCount", [Trip Num for Matrix (No Blank Values)]
			        ),
			        [TripCount],
			        DESC,
			        'Dim Date'[FullDayName]
			    ),
			    'Dim Date'[FullDayName] -- ИСПРАВЛЕНИЕ: извлекаем название дня (текст), а не количество
			)
			
			VAR TotalTripsOnBestDay = 
			CALCULATE(
			    [Trips Num],
			    'Dim Date'[FullDayName] = BestWeekDay
			)
			
			VAR Windows = 
			ADDCOLUMNS(
			    GENERATESERIES(0,20,1),
			    "WindowSum",
			    CALCULATE(
			        [Trips Num],
			        FILTER(
			            'Fact',
			            HOUR('Fact'[lpep_pickup_time]) >= [Value] &&
			            HOUR('Fact'[lpep_pickup_time]) <= [Value] + 3
			        ),
			        'Dim Date'[FullDayName] = BestWeekDay
			    )
			)
			
			VAR BestWindow =
			TOPN(
			    1, Windows, [WindowSum], DESC
			)
			
			VAR BestStartHour = MINX(BestWindow, [Value])
			VAR BestEndHour = BestStartHour + 3
			
			VAR BestWindowTripCount = MINX(BestWindow, [WindowSum])
			
			VAR PercentofTotal =
			DIVIDE(BestWindowTripCount, TotalTripsOnBestDay, 0)
			
			RETURN
			
			"<p style='font-family:""Segoe UI Semibold"", sans-serif;font-size:16px;color:black;'>" &
			    "The Biggest Number Of Trips " &
			    "<span style='color:#647CA1;'><strong>" &
			    FORMAT(BestWindowTripCount, "#,0") &
			    "</strong></span> " &
			    "<span style='color:green;'>" &
			    FORMAT(PercentofTotal, "0%") &
			    "</span> Occurs on " &
			    "<span style='color:#647CA1;'><strong>" &
			    BestWeekDay &
			    "</strong></span> from " &
			    "<span style='color:green;'><strong>" &
			    FORMAT(TIME(BestStartHour, 0, 0), "h AM/PM") & " to " &
			    FORMAT(TIME(BestEndHour, 0, 0), "h AM/PM") &
			    "</strong></span>" &
			"</p>"
			```
		lineageTag: 751c5ee7-c2dc-44ff-8c3d-f0abb3d4a663

	measure 'Top 1 Drop-Off Zone HTML with %' = ```
			
			VAR ZoneSummary =
			    ADDCOLUMNS(
			        VALUES( TaxiZones[Zone] ),
			        "DropoffCount", CALCULATE( [Trips Num Dropoff Location] )
			    )
			VAR TopTable =
			    TOPN(
			        1,
			        ZoneSummary,
			        [DropoffCount], DESC
			    )
			VAR Zone1  = MAXX( TopTable, TaxiZones[Zone] )
			VAR Count1 = MAXX( TopTable, [DropoffCount] )
			VAR TotalDrops =
			    CALCULATE( [Trips Num Dropoff Location] )
			VAR Pct1 = DIVIDE( Count1, TotalDrops, 0 )
			RETURN
			    "<p style='font-family:""Segoe UI Semibold"", sans-serif; font-size:16px; color:black;'>
			       The Most Popular Drop-Off Location is: 
			       <span style='color:#647CA1;'><strong>" & Zone1 & "</strong></span> " &
			       FORMAT( Count1, "#,0" ) & " Trips (<span style='color:green;'>" &
			       FORMAT( Pct1, "0%" ) & "</span>)
			     </p>"
			```
		lineageTag: ce981d57-0314-45da-86f4-00bab0d96fb1

	measure 'Top 2 Pick Up Zones HTML with %' = ```
			
			VAR ZoneSummary =
			    ADDCOLUMNS(
			        VALUES( TaxiZones[Zone] ),
			        "PickupCount", CALCULATE( [Trips Num] )
			    )
			
			// Zone 1 and its count
			VAR Top1Table =
			    TOPN(
			        1,
			        ZoneSummary,
			        [PickupCount], DESC
			    )
			VAR Zone1  = MAXX( Top1Table, TaxiZones[Zone] )
			VAR Count1 = MAXX( Top1Table, [PickupCount] )
			
			// Zone 2 and its count
			VAR Top2Table =
			    TOPN(
			        1,
			        FILTER(
			            ZoneSummary,
			            TaxiZones[Zone] <> Zone1
			        ),
			        [PickupCount], DESC
			    )
			VAR Zone2  = MAXX( Top2Table, TaxiZones[Zone] )
			VAR Count2 = MAXX( Top2Table, [PickupCount] )
			
			// Total trips across all zones (in current filter context)
			VAR TotalTrips =
			    CALCULATE( [Trips Num] )
			
			// Percentage of total for each top zone
			VAR Pct1 = DIVIDE( Count1, TotalTrips, 0 )
			VAR Pct2 = DIVIDE( Count2, TotalTrips, 0 )
			
			RETURN
			    "<p style='font-family:""Segoe UI Semibold"", sans-serif; font-size:16px; color:black;'>
			       The Most Popular 2 Pick-Up Locations are:
			       <br/>
			       <span style='color:#647CA1;'><strong>" & Zone1 & "</strong></span> " &
			         FORMAT( Count1, "#,0" ) & " Trips (<span style='color:green;'>" &
			         FORMAT( Pct1, "0%" ) & "</span>)
			       and <span style='color:#647CA1;'><strong>" & Zone2 & "</strong></span> " &
			         FORMAT( Count2, "#,0" ) & " Trips (<span style='color:green;'>" &
			         FORMAT( Pct2, "0%" ) & "</span>)
			     </p>"
			
			```
		lineageTag: 16d76e11-1ff9-4d42-951a-3f970d4e521d

	measure '_1 Previous Month Trips Num' =
			
