	measure 'Top 1 Payment Type' = ```
			
			VAR PaymentSummary = 
			ADDCOLUMNS(
			    VALUES('Fact'[paymeny_time_detailed]),
			    "TripsCount",
			    CALCULATE(
			        [Trips Num]
			    )
			)
			
			VAR TopRow = 
			TOPN(
			    1,
			    PaymentSummary,
			    [TripsCount],
			    DESC
			)
			RETURN
			MAXX(TopRow, 'Fact'[paymeny_time_detailed])
			```
		displayFolder: Total Numbers
		lineageTag: 0218a81e-819a-4164-b31f-ac357f9c8ba1

