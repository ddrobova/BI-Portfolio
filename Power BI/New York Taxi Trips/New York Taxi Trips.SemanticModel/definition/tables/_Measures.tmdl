	measure 'Borough Color' =
			
			VAR _Borough = SELECTEDVALUE(TaxiZones[Borough])
			
			RETURN
			SWITCH(
			    TRUE(),
			    _Borough = "Queens", "#647CA1",
			    _Borough = "Brooklyn", "#778EB4",
			    _Borough = "Manhattan", "#93ABD2",
			    _Borough = "Bronx", "#D4DDED"
			)
		displayFolder: Colors
